# claude.ai session cookie — copy from browser DevTools > Application > Cookies > claude.ai > sessionKey
# Valid for ~30 days. Required for automated upload.
CLAUDE_SESSION_KEY=

# Cloudflare bypass cookies — required for non-browser access
# Copy from browser DevTools > Application > Cookies > claude.ai
CF_CLEARANCE=
CF_BM=

# Browser User-Agent — must match the browser that solved the Cloudflare challenge
# Copy from browser DevTools > Network > any request > Request Headers > User-Agent
# Cloudflare ties cf_clearance to the exact UA used when the challenge was solved.
USER_AGENT=
